{
  "name": "pedit-serve-app",
  "private": true,
  "type": "module",
  "description": "A sample local app built on @pedit/serve: an editor bound to a file that `pedit serve` holds",
  "scripts": {
    "build": "esbuild page.mjs --bundle --format=esm --alias:yjs=./node_modules/yjs --alias:y-protocols=./node_modules/y-protocols --outfile=public/page.js",
    "start": "node server.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.0",
    "@hono/node-server": "^2.1.6",
    "@pedit/serve": "^0.6.0",
    "codemirror": "^6.0.1",
    "hono": "^4.9.0",
    "ws": "^8.18.0",
    "y-codemirror.next": "^0.3.5",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
