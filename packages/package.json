{
  "name": "pedit-server",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.4",
      "undici": "7.29.1"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "deploy": "node scripts/deploy-self-host.mjs",
    "deploy:production": "pnpm --filter @pedit/worker run deploy",
    "test:deploy": "node --test scripts/deploy-self-host.test.mjs scripts/celld.test.mjs",
    "deploy:lab": "pnpm --filter @pedit/worker run deploy:lab",
    "celld:dev": "pnpm run build && celld dev ./celld.jsonc",
    "preview": "pnpm --filter @pedit/worker run preview",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check --config-path biome.server.json .",
    "format": "biome format --config-path biome.server.json --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
