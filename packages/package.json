{
  "name": "pedit-server",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5",
      "@cloudflare/vitest-pool-workers>zod": "4.6.7",
      "miniflare>undici": "7.30.1"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "deploy": "node scripts/deploy-self-host.mjs",
    "deploy:production": "node scripts/deploy-production.mjs",
    "test:deploy": "node --test scripts/deploy-self-host.test.mjs scripts/deploy-production.test.mjs",
    "deploy:lab": "pnpm --filter @pedit/worker run deploy:lab",
    "preview": "pnpm --filter @pedit/worker run preview",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check --config-path biome.server.json .",
    "format": "biome format --config-path biome.server.json --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
