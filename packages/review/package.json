{
  "name": "@pedit/review",
  "version": "0.1.0",
  "description": "The <pedit-review> element: review a shared pedit file on your own page, end-to-end encrypted, as one static JavaScript file",
  "keywords": [
    "pedit",
    "web-component",
    "yjs",
    "collaborative-editing",
    "end-to-end-encryption"
  ],
  "license": "MIT",
  "homepage": "https://github.com/piconic-ai/pedit/tree/main/packages/review#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piconic-ai/pedit.git",
    "directory": "packages/review"
  },
  "type": "module",
  "sideEffects": [
    "./dist/pedit-review.js"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && vite build && vite build --config vite.csp.config.ts && tsc -p tsconfig.dts.json",
    "prepack": "cp ../../LICENSE LICENSE",
    "postpack": "rm -f LICENSE",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@barefootjs/client": "0.40.2",
    "@barefootjs/jsx": "0.40.2",
    "@barefootjs/vite": "0.40.2",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@pedit/protocol": "workspace:^",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "codemirror": "^6.0.2",
    "jsdom": "^30.1.3",
    "vite": "^8.3.5",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "exports": {
    ".": "./dist/pedit-review.js",
    "./csp": {
      "types": "./dist/csp.d.ts",
      "import": "./dist/csp.js"
    }
  }
}
