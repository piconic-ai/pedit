{
  "name": "@pedit/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @pedit/web build && wrangler dev --config wrangler.jsonc",
    "deploy": "pnpm --filter @pedit/web build && wrangler deploy --config wrangler.jsonc",
    "cf-typegen": "wrangler types --config wrangler.jsonc",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "deploy:lab": "pnpm --filter @pedit/web build && wrangler deploy --config wrangler.jsonc --env lab",
    "preview": "pnpm --filter @pedit/web build && wrangler preview --config wrangler.jsonc"
  },
  "dependencies": {
    "@pedit/protocol": "workspace:^",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "wrangler": "^4.151.2",
    "yjs": "^13.6.33"
  }
}
