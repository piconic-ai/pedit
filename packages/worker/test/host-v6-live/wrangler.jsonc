{
  "name": "pedit-host-recovery-local-test",
  "main": "worker.ts",
  "vars": { "KEEP_MAX_SECONDS": "3600", "KEEP_PUBLIC_V6": "1" },
  "compatibility_date": "2026-08-01",
  "ratelimits": [
    { "name": "ROOM_CREATION_LIMIT", "namespace_id": "2001", "simple": { "limit": 1000, "period": 60 } },
    { "name": "CONNECTION_LIMIT", "namespace_id": "2002", "simple": { "limit": 1000, "period": 60 } }
  ],
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
